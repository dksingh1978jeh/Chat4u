# GEMINI_API_KEY: Required for Gemini AI message translation on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing secret for SmartConnect session tokens.
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"

# Cloud SQL PostgreSQL Connection Variables (automatically injected by AI Studio)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
